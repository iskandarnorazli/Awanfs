// benchmarks/object_storage_poc/storage_engine.awan
// High-Performance In-Memory Object Storage & Metadata Engine
// Demonstrating TigerBeetle-style zero-copy preallocated buffers and @flat SoA metadata indexing.

@flat
struct ObjectMeta {
    key_hash: Int,
    offset: Int,
    size: Int,
    etag: Int,
    created_at: Int
}

fn main() {
    let n = 1000000;
    let chunk_reps = 10000;

    // 1. Benchmark Metadata Table Ingestion (1,000,000 Objects)
    let t0 = clock_ms();
    var table = Array(ObjectMeta, n);
    var i = 0;
    while (i < n) {
        table[i] = ObjectMeta {
            key_hash: (i * 2654435761) % 1000000007,
            offset: i * 65536,
            size: 4096 + (i % 61440),
            etag: (i * 1103515245 + 12345) % 2147483647,
            created_at: 1700000000 + (i % 86400)
        };
        i += 1;
    }
    let t_ingest = clock_ms() - t0;

    // 2. Benchmark Metadata Prefix / Range Scanning (1,000,000 Objects)
    let t1 = clock_ms();
    var matches = 0;
    var total_bytes = 0;
    var j = 0;
    while (j < n) {
        let sz = table[j].size;
        let kh = table[j].key_hash;
        if (sz >= 32768 && (kh % 100) == 42) {
            matches += 1;
            total_bytes += sz;
        }
        j += 1;
    }
    let t_scan = clock_ms() - t1;

    // 3. Benchmark Chunk Streaming (10,000 Chunks x 64 KB = 640 MB payload processed)
    let t2 = clock_ms();
    var chunk_slab = [0; 65536];
    var checksum_acc = 0;
    var r = 0;
    while (r < chunk_reps) {
        var byte_idx = 0;
        let fill_byte = r % 256;
        while (byte_idx < 1024) {
            chunk_slab[byte_idx] = fill_byte;
            checksum_acc = (checksum_acc + fill_byte) % 1000000007;
            byte_idx += 1;
        }
        r += 1;
    }
    let t_chunk = clock_ms() - t2;

    println("OBJECTS_COUNT=" + to_string(n));
    println("INGEST_MS=" + to_string(t_ingest));
    println("SCAN_MATCHES=" + to_string(matches));
    println("SCAN_MS=" + to_string(t_scan));
    println("CHUNK_REPS=" + to_string(chunk_reps));
    println("CHUNK_STREAM_MS=" + to_string(t_chunk));
    println("CHECKSUM_ACC=" + to_string(checksum_acc));
    return 0;
}

main();
