{
  "title": "AwanFS",
  "uid": "awanfs",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "awanfs",
    "s3"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by operation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(awanfs_requests_total[$__rate_interval]))",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error ratio (5xx / all)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(awanfs_requests_total{status=\"5xx\"}[$__rate_interval])) / sum(rate(awanfs_requests_total[$__rate_interval]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(awanfs_requests_total{status=\"4xx\"}[$__rate_interval])) / sum(rate(awanfs_requests_total[$__rate_interval]))",
          "legendFormat": "4xx"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p99 by operation",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (operation, le) (rate(awanfs_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (operation, le) (rate(awanfs_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{operation}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bytes in and out",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(awanfs_request_bytes_total[$__rate_interval])",
          "legendFormat": "in"
        },
        {
          "refId": "B",
          "expr": "rate(awanfs_response_bytes_total[$__rate_interval])",
          "legendFormat": "out"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Volume use",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "awanfs_volume_used_bytes",
          "legendFormat": "used (all volumes)"
        },
        {
          "refId": "B",
          "expr": "awanfs_volume_free_span_bytes",
          "legendFormat": "free span in the active volume"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Writes per sync (group commit batch size)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(awanfs_disk_writes_total[$__rate_interval]) / rate(awanfs_disk_syncs_total[$__rate_interval])",
          "legendFormat": "writes per sync"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Payload cache hit ratio",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(awanfs_payload_cache_hits_total[$__rate_interval]) / (rate(awanfs_payload_cache_hits_total[$__rate_interval]) + rate(awanfs_payload_cache_misses_total[$__rate_interval]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Ready",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "awanfs_ready",
          "legendFormat": "ready"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Payload copies per second",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(awanfs_payload_copy_bytes_total[$__rate_interval])",
          "legendFormat": "bytes copied"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Open volumes",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "awanfs_volumes_open",
          "legendFormat": "open"
        },
        {
          "refId": "B",
          "expr": "awanfs_active_volume_id",
          "legendFormat": "active id"
        }
      ]
    }
  ]
}
