// awan-storage/engine/storage_core.awan
// Awan Storage Native Engine — 64-Byte @flat ObjectMeta SoA & PartExtent Table
// Architecture Reference: awan-storage/ARCHITECTURE.md Section 2

@flat
struct ObjectMeta {
    key_hash: Int,      // 64-bit keyed hash of (bucket_id, key_bytes)
    bucket_flags: Int,  // High 32b: bucket_id | Mid 16b: part_count | Low 16b: status flags
    vol_offset: Int,    // High 16b: volume_id | Low 48b: 4KB-aligned offset or PartExtent idx
    size: Int,          // Total decoded object payload size in bytes
    etag_hi: Int,       // Upper 64 bits of 128-bit MD5 digest
    etag_lo: Int,       // Lower 64 bits of 128-bit MD5 digest
    created_at: Int,    // Unix epoch timestamp in milliseconds
    key_slice: Int      // High 48b: byte offset in Key String Arena | Low 16b: key byte length
}

@flat
struct PartExtent {
    vol_offset: Int,     // High 16b: volume_id | Low 48b: byte offset in volume
    part_size: Int,      // Byte length of this part
    cumulative_end: Int, // Prefix-sum end offset within logical object
    ref_count: Int       // Reference count for zero-copy cloning and MVCC pins
}

fn make_bucket_flags(bucket_id: Int, part_count: Int, flags: Int) -> Int {
    return (bucket_id * 4294967296) + (part_count * 65536) + flags;
}

fn get_bucket_id(bucket_flags: Int) -> Int {
    return bucket_flags / 4294967296;
}

fn get_part_count(bucket_flags: Int) -> Int {
    return (bucket_flags / 65536) % 65536;
}

fn get_flags(bucket_flags: Int) -> Int {
    return bucket_flags % 65536;
}

fn make_key_slice(arena_offset: Int, key_len: Int) -> Int {
    return (arena_offset * 65536) + key_len;
}

fn get_arena_offset(key_slice: Int) -> Int {
    return key_slice / 65536;
}

fn get_key_len(key_slice: Int) -> Int {
    return key_slice % 65536;
}
